{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "0.2.0",
  "identifier": "com.rain9.luma",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1030",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luma",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMzA1OEZDMjZDQThERDIKUldUU2pjb20vRmd3Y2FXaElJMFdKeUUrQUI5UjVZZDBwVmFzSEMyKzVoMk1JamZJdWw5QnZxMTcK",
      "endpoints": [
        "https://github.com/you-want/Luma/releases/latest/download/latest.json"
      ]
    }
  }
}
